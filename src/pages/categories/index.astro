---
import TaxonomyIndex from '../../components/TaxonomyIndex.astro'
import Base from '../../layouts/Base.astro'
import { publishedPosts, taxonomyTerms } from '../../lib/content.ts'
import { site } from '../../site.ts'

const posts = await publishedPosts()
const terms = taxonomyTerms(posts, 'categories')
const categories = terms.map((term) => term.name)
---

<Base title="Categories" description="" canonicalPath="/categories/" image={site.ogImage}>
	<TaxonomyIndex title="Categories" terms={terms} termBase="categories" categories={categories} />
</Base>
