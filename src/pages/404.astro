---
import Base from '../layouts/Base.astro'
import { site } from '../site.ts'
---

<Base title="404 - Page Not Found" description="" canonicalPath="/404/" noindex image={site.ogImage}>
	<div class="container container-custom">
		<h1>404 - Page Not Found</h1>
		<p>Whatever you are looking for, it is not here.</p>
		<p>
			Try <a href="/work/">Case Studies (/work)</a>, <a href="/services/">Services (/services)</a>,{' '}
			<a href="/blog/">Blog (/blog)</a>, <a href="/about/">About (/about)</a>, or head back to the{' '}
			<a href="/">homepage</a>.
		</p>
	</div>
</Base>
