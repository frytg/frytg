---
import { getEntry, render } from 'astro:content'
import Base from '../layouts/Base.astro'
import { absoluteOgImageUrl, homeJsonLd } from '../lib/json-ld.ts'
import { site } from '../site.ts'

const home = await getEntry('pages', '_index')
if (!home) {
	throw new Error('Missing content/_index.md')
}

const { Content } = await render(home)
const description = home.data.seo_description ?? ''
const imageUrl = await absoluteOgImageUrl(home.data.image ?? site.ogImage)
---

<Base
	title={home.data.title}
	description={description}
	canonicalPath="/"
	image={home.data.image ?? site.ogImage}
	jsonLd={homeJsonLd({ description, imageUrl })}
>
	<div class="container container-custom">
		<Content />
	</div>
</Base>
