---
import { getCollection, render } from 'astro:content'
import Base from '../layouts/Base.astro'
import { absoluteOgImageUrl, pageJsonLd } from '../lib/json-ld.ts'
import { absoluteUrl, site } from '../site.ts'

/** @returns Trailing-slash routes for the Markdown content pages. */
export const getStaticPaths = async () => {
	const plainPages = new Set(['about', 'services', 'work', 'social', 'uses', 'dev', 'legal'])
	const pages = await getCollection('pages', ({ id }) => plainPages.has(id))
	return pages.map((page) => ({
		params: { page: page.id },
		props: { page },
	}))
}

const { page } = Astro.props
const { Content } = await render(page)
const permalink = `/${page.id}/`
const description = page.data.seo_description ?? ''
const image = page.data.image ?? site.ogImage
const imageUrl = await absoluteOgImageUrl(image)
---

<Base
	title={page.data.title}
	description={description}
	canonicalPath={permalink}
	image={image}
	noindex={page.data.noindex ?? false}
	jsonLd={pageJsonLd({
		id: page.id,
		title: page.data.title,
		url: absoluteUrl(permalink),
		description,
		imageUrl,
	})}
>
	<div class="container container-custom">
		<Content />
	</div>
</Base>
