---
import { getCollection, render } from 'astro:content'
import PostFooter from '../../components/PostFooter.astro'
import { formatDateHuman, formatDateIso } from '../../lib/dates.ts'
import { absoluteOgImageUrl, blogPostingJsonLd, countWords } from '../../lib/json-ld.ts'
import Base from '../../layouts/Base.astro'
import { absoluteUrl, blogPermalink, site } from '../../site.ts'

export const getStaticPaths = async () => {
	const posts = await getCollection('blog', ({ data }) => !data.draft)
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}))
}

const { post } = Astro.props
const { Content } = await render(post)
const permalink = blogPermalink(post.id)
const description = post.data.seo_description ?? post.data.summary ?? ''
const publishedTime = formatDateIso(post.data.date)
const imageUrl = await absoluteOgImageUrl(post.data.image ?? site.ogImage)
const jsonLd = blogPostingJsonLd({
	headline: post.data.title,
	url: absoluteUrl(permalink),
	description,
	imageUrl,
	datePublished: publishedTime,
	dateModified: publishedTime,
	keywords: post.data.tags,
	wordCount: countWords(post.body),
})

const highlightClass = post.data.highlight_bold ? ' container-bold' : ''
---

<Base
	title={post.data.title}
	description={description}
	canonicalPath={permalink}
	image={post.data.image ?? site.ogImage}
	ogType="article"
	atUri={post.data.atUri}
	publishedTime={publishedTime}
	modifiedTime={publishedTime}
	jsonLd={jsonLd}
	rssHref="/blog/index.xml"
>
	<div class={`container container-custom${highlightClass}`}>
		<h1 itemprop="headline">{post.data.title}</h1>
		<p class="text-meta">
			<time datetime={publishedTime}>{formatDateHuman(post.data.date)}</time>
		</p>
		<Content />
		<PostFooter atUri={post.data.atUri} tags={post.data.tags} />
	</div>
</Base>
