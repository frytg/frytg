---
import beOriginal from '../../assets/svg/beoriginal/white.svg?url'
import logo from '../../assets/svg/logo-white.svg?url'
import { site } from '../site.ts'
---

<div id="footer" class="content-column py-12 flex flex-col items-center gap-4 text-center">
	<div class="flex flex-col items-center opacity-80">
		<img class="h-8 w-auto" src="/eu-flag-color.svg" alt="European Union" title="European Union" loading="lazy" />
	</div>
	
	<div class="flex flex-col items-center opacity-80">
		<img class="h-8 w-auto" src={beOriginal} alt="Be Original Claim" loading="lazy" />
	</div>

	<p class="text-meta my-0 max-w-md">
		Follow on
		{
			site.menus.social.map((item) => (
				<>
					{' '}
					<a href={item.url} target="_blank" rel="me noopener noreferrer" title={`${item.name}: ${item.handle}`}>
						{item.name}
					</a>
					{item.post}
				</>
			))
		}.
	</p>

	<p class="text-meta my-0">
		No cookies stored. Analytics by{' '}
		<a href="https://usefathom.com/ref/DJCJEW" target="_blank" title="Fathom Analytics">Fathom</a>.
	</p>

	<p class="text-meta my-0">
		<a href="/legal/" title="Impressum">Legal & Privacy</a>
	</p>

	<p class="text-meta my-0 flex items-center justify-center gap-2">
		<span>© Daniel Freytag</span>
		<span class="text-white/20">·</span>
		<a
			href="https://www.frytg.digital/?ref=frytg-com-footer"
			target="_blank"
			title="FRYTG digital"
			class="inline-flex items-center"
		>
			<img class="h-5 w-auto opacity-70 hover:opacity-100 transition-opacity" src={logo} alt="FRYTG digital" />
		</a>
	</p>
</div>
