---
import '../../assets/css/fonts.scss'
import '../../assets/css/main.css'
import { absoluteUrl, site } from '../site.ts'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import { renderOgImage } from '../lib/responsive-images.ts'

type Props = {
	title: string
	description?: string
	canonicalPath: string
	image?: string
	ogType?: 'website' | 'article'
	noindex?: boolean
	atUri?: string
	publishedTime?: string
	modifiedTime?: string
	jsonLd?: Record<string, unknown>
	rssHref?: string
}

const {
	title,
	description = '',
	canonicalPath,
	image = site.ogImage,
	ogType = 'website',
	noindex = false,
	atUri,
	publishedTime,
	modifiedTime,
	jsonLd,
	rssHref,
} = Astro.props

const pageTitle = Astro.url.pathname === '/' ? site.title : `${title} | ${site.title}`
const twitterTitle = Astro.url.pathname === '/' ? site.title : `${title} · ${site.title}`
const canonical = absoluteUrl(canonicalPath)
const ogImagePath = (await renderOgImage(image)) ?? image
const ogImage = absoluteUrl(ogImagePath)
const escapedDescription = description
---

<!doctype html>
<html class="bg-mid-dark-greeny text-white font-sans selection:bg-yellow selection:text-greeny" lang={site.locale} dir="ltr">
	<head>
		<title>{pageTitle}</title>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
		<meta name="HandheldFriendly" content="True" />
		<meta name="MobileOptimized" content="320" />
		<meta name="author" content={site.author.name} />
		<meta name="msvalidate.01" content="C1816188C38BDCCB8E9E9CEEF79E5110" />
		<meta name="fediverse:creator" content="@FRYTG@beoriginal.social" />
		{rssHref && (
			<link rel="alternate" type="application/rss+xml" href={absoluteUrl(rssHref)} title={site.title} />
		)}
		{atUri && <link rel="site.standard.document" href={atUri} />}
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="apple-touch-icon" href="/favicon.png" />
		<link rel="shortcut icon" href="/favicon.png" />
		<meta name="theme-color" content="#293126" />
		<meta name="msapplication-TileColor" content="#293126" />
		<link rel="canonical" href={canonical} itemprop="url" />
		<meta name="url" content={canonical} />
		<meta name="twitter:url" content={canonical} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:image" content={ogImage} />
		{publishedTime && <meta property="article:published_time" content={publishedTime} />}
		{publishedTime && <meta property="og:article:published_time" content={publishedTime} />}
		{publishedTime && <meta itemprop="datePublished" content={publishedTime} />}
		{modifiedTime && <meta itemprop="dateModified" content={modifiedTime} />}
		<meta name="description" content={escapedDescription} />
		<meta name="twitter:description" content={escapedDescription} />
		<meta property="og:description" content={escapedDescription} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={twitterTitle} />
		<meta name="twitter:site" content="@FRYTG" />
		<meta name="twitter:creator" content="@FRYTG" />
		<meta name="twitter:creator:id" content="46650115" />
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={twitterTitle} />
		<meta property="og:site_name" content={site.title} />
		{jsonLd && (
			<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
		)}
		{import.meta.env.PROD && (
			<script is:inline src="https://cdn.usefathom.com/script.js" data-site={site.fathomSite} defer></script>
		)}
	</head>
	<body>
		<header class="site-header"><Header /></header>
		<main>
			<slot />
		</main>
		<footer class="site-footer"><Footer /></footer>
		<script src="../../assets/js/main.js"></script>
	</body>
</html>
